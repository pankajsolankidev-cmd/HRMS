# Server Configuration
PORT=4000
NODE_ENV=production
ALLOWED_ORIGINS=https://your-frontend-url.vercel.app,http://localhost:5173

# Database Configuration (Neon/Supabase)
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=neondb
DB_SSL=true

# Redis Configuration (Upstash)
# Option 1: Use a connection string (Recommended for Upstash)
REDIS_URL=rediss://default:your-password@your-host.upstash.io:6379
# Option 2: Use host/port
REDIS_HOST=your-redis-host.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-password
REDIS_TLS=true

# Authentication
JWT_SECRET=your-very-secret-key-change-this

# Sentry (Optional)
SENTRY_DSN=
